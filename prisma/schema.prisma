generator client {
  provider = "prisma-client"
  // This output path is critical for Next.js 15+ compatibility
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Note: NO 'url' line here
}

//  USER MODEL
// Stores core user profile information
//  USER MODEL
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]

  // RELATIONS (Back-references)
  cars     Car[] // Added: This user can be a HOST of many cars
  bookings Booking[] // Already in your code
  reviews  Review[] // Added: This user can write many reviews

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//  ACCOUNT MODEL
// Links social providers (Google, GitHub) to a specific User
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

//   SESSION MODEL
// Used for database-based session persistence
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//  VERIFICATION TOKEN
// Used for magic links / email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- APP SPECIFIC ENUMS & MODELS ---

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  HOST
}

model Car {
  id    String @id @default(cuid())
  name  String
  brand String // e.g., "Tesla", "Porsche"
  model String // e.g., "Model 3", "911"
  year  Int
  type  String // SUV, Luxury, Sedan

  // Pricing & Value
  pricePerDay     Int
  securityDeposit Int @default(0) // Added for host protection

  // Technical Specs
  seats        Int
  transmission String // Automatic / Manual
  fuelType     String // Petrol, Electric, Hybrid
  engineSize   String? // e.g., "2.0L"
  horsepower   Int?

  // Media & Info
  image       String // Primary image
  images      String[] // Array of additional gallery images
  description String?  @db.Text

  // Availability & Location
  isAvailable   Boolean   @default(true)
  availableFrom DateTime? // Start of availability window
  availableTo   DateTime? // End of availability window
  location      String // City name or address
  lat           Float? // For Map integration
  lng           Float? // For Map integration

  // Relations
  hostId   String
  host     User      @relation(fields: [hostId], references: [id])
  bookings Booking[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  startDate     DateTime
  endDate       DateTime
  totalPrice    Int
  status        String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  
  // New Fields for your UI features
  includeTank      Boolean @default(false)
  includeChildSeat Boolean @default(false)
  protectionPlan   String  @default("BASIC") // BASIC, STANDARD, PREMIUM
  serviceFee       Int     @default(25)

  // Relations
  carId  String
  car    Car    @relation(fields: [carId], references: [id])
  
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Payment Link (One-to-One)
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id            String   @id @default(cuid())
  amount        Int
  currency      String   @default("USD")
  status        String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  method        String   // CARD, STRIPE, PAYPAL
  transactionId String?  @unique // ID from external provider (Stripe/PayPal)

  // Relation to Booking
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1 to 5
  comment   String?
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
