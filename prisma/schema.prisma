generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- USER MODEL ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  
   
  phoneNumber         String?
  


  kyc             String[] // Array of strings to store S3 URLs
  isKycUploaded   Boolean  @default(false)
  isIdentityVerified Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  cars          Car[]     
  bookings      Booking[] 
  reviews       Review[]  

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// --- APP SPECIFIC ENUMS ---
enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  HOST
}

// --- CAR MODEL ---
model Car {
  id              String    @id @default(cuid())
  name            String
  brand           String    
  model           String    
  year            Int
  type            String    

  pricePerDay     Int
  securityDeposit Int       @default(0)

  seats           Int
  transmission    String    
  fuelType        String    
  engineSize      String?   
  horsepower      Int?

  image           String    
  images          String[]  
  description     String?   @db.Text

  // Health Tracking Additions
  currentMileage  Int       @default(0)
  nextServiceKm   Int?

  isAvailable     Boolean   @default(true)
  availableFrom   DateTime? 
  availableTo     DateTime? 
  location        String    
  lat             Float?    
  lng             Float?    

  hostId          String
  host            User      @relation(fields: [hostId], references: [id])
  bookings        Booking[]
  reviews         Review[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// --- BOOKING MODEL ---
model Booking {
  id               String    @id @default(cuid())
  startDate        DateTime
  endDate          DateTime
  totalPrice       Int
  status           String    @default("PENDING") 
  
  includeTank      Boolean   @default(false)
  includeChildSeat Boolean   @default(false)
  protectionPlan   String    @default("BASIC") 
  serviceFee       Int       @default(25)

 
  handoverOtp      String?   // For secure key exchange
  
  
  pickupPhotos     String[]  // Photo proof at start
  returnPhotos     String[]  // Photo proof at end
  startMileage     Int?
  endMileage       Int?
  startFuelLevel   Int?      // 0-100 percentage
  endFuelLevel     Int?

   
  actualPickupTime DateTime? 
  actualReturnTime DateTime?

  carId            String
  car              Car       @relation(fields: [carId], references: [id])
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  
  payment          Payment?
  incidents        Incident[] // New relation for disputes

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// --- PAYMENT MODEL ---
model Payment {
  id               String    @id @default(cuid())
  amount           Int
  currency         String    @default("USD")
  status           String    @default("PENDING") 
  method           String    
  transactionId    String?   @unique 

  // Security Deposit Tracking
  depositReleased  Boolean   @default(false)

  bookingId        String    @unique
  booking          Booking   @relation(fields: [bookingId], references: [id])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ---   INCIDENT MODEL ---
model Incident {
  id          String   @id @default(cuid())
  type        String   // ACCIDENT, SCRATCH, LATE_RETURN, CLEANING
  description String   @db.Text
  images      String[]
  status      String   @default("OPEN") // OPEN, RESOLVED
  
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])

  createdAt   DateTime @default(now())
}

// auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int 
  comment   String?
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}