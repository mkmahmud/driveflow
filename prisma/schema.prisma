generator client {
  provider = "prisma-client"
  // This output path is critical for Next.js 15+ compatibility
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Note: NO 'url' line here
}

model Car {
  id           String   @id @default(cuid())
  name         String
  type         String   // e.g., "SUV", "Luxury"
  pricePerDay  Int
  seats        Int
  transmission String   // "Automatic" or "Manual"
  fuelType     String   // "Petrol", "Electric", "Hybrid"
  image        String   // URL to image
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// 1. USER MODEL
// Stores core user profile information
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?    
  role          Role      @default(USER)  
  accounts      Account[]
  sessions      Session[]
  
  // Custom: Connect users to their car bookings
  bookings      Booking[] 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// 2. ACCOUNT MODEL
// Links social providers (Google, GitHub) to a specific User
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// 3. SESSION MODEL
// Used for database-based session persistence
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 4. VERIFICATION TOKEN
// Used for magic links / email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- APP SPECIFIC ENUMS & MODELS ---

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  HOST
}

// Example Booking model to get you started
model Booking {
  id        String   @id @default(cuid())
  userId    String
  carId     String   // You would link this to a Car model later
  startDate DateTime
  endDate   DateTime
  status    String   @default("PENDING")
  user      User     @relation(fields: [userId], references: [id])
}